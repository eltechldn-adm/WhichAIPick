    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:pages": "node scripts/generate-static-pages.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "inject:header": "node scripts/inject-header.mjs",
    "inject:footer": "node scripts/inject-footer.mjs",
    "predeploy": "node scripts/generate-static-pages.mjs && node scripts/inject-header.mjs && node scripts/inject-footer.mjs && node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "sharp": "^0.33.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
